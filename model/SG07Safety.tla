  <2>7. (TypeOK /\ MetadataCoherence /\ NoBlindRedispatch /\ Dispatch(k, p, c)) =>
           NoBlindRedispatch'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, MetadataCoherence, NoBlindRedispatch
  <2>8. (AuthorizedWrite /\ MetadataCoherence /\ Dispatch(k, p, c)) => AuthorizedWrite'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, MetadataCoherence, AuthorizedWrite
  <2>9. (ConfirmationProvenance /\ MetadataCoherence /\ Dispatch(k, p, c)) => ConfirmationProvenance'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, MetadataCoherence, ConfirmationProvenance
  <2>10. (TypeOK /\ MetadataCoherence /\ PhasePredecessorCoherence /\
           Dispatch(k, p, c)) => PhasePredecessorCoherence'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, MetadataCoherence, PhasePredecessorCoherence
  <2>11. (TypeOK /\ MetadataCoherence /\ Dispatch(k, p, c)) => MetadataCoherence'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, TypeOK, MetadataCoherence, PrepKey, PrepClient,
      PrepIntent, PrepBase, PrepAfter, NoKey, NoPrep
  <2> QED BY <2>1, <2>2, <2>3, <2>4, <2>5, <2>6, <2>7, <2>8, <2>9, <2>10,
    <2>11 DEF StrengthenedInv, Safety
<1>2. ASSUME NEW k \in Keys, NEW p \in Preps, NEW d \in Intents
      PROVE (StrengthenedInv /\ Replay(k, p, d)) => StrengthenedInv'
  BY DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Replay, vars, StrengthenedInv, Safety, TypeOK, AtMostOnce,
