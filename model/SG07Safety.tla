----------------------------- MODULE SG07Safety -----------------------------
EXTENDS SG07, TLAPS

\* Every proof step is explicit; no proof obligation is omitted.
THEOREM InitInductive == Init => StrengthenedInv
BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Init, StrengthenedInv, Safety, TypeOK, Phases, Results, Tokens,
  AtMostOnce, UniqueLiveClaims, ResourceCoherence, JournalBeforeIO,
  ActiveClaimRetention, NoBlindRedispatch, AuthorizedWrite,
  ConfirmationProvenance, MetadataCoherence, PhasePredecessorCoherence,
  Keys, Clients, Preps, Files, Digests, Intents, NoKey, NoPrep

THEOREM ReplayObservational ==
  \A k \in Keys, p \in Preps, d \in Intents :
    Replay(k, p, d) => UNCHANGED EffectVars
BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Replay, EffectVars, vars

THEOREM LookupObservational ==
  \A k \in Keys, c \in Clients :
    HistoricalLookup(k, c) => UNCHANGED EffectVars
BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, HistoricalLookup, EffectVars, vars

THEOREM RevokedStaleNoWrite ==
  \A k \in Keys, f \in Files :
    (Write(k, f) /\ (~Authority(k) \/ ~Predecessor(k, f))) => FALSE
BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Write, LiveAtWrite

THEOREM NextInductive == StrengthenedInv /\ [Next]_vars => StrengthenedInv'
<1>1. ASSUME NEW k \in Keys, NEW p \in Preps, NEW c \in Clients
      PROVE (StrengthenedInv /\ Dispatch(k, p, c)) => StrengthenedInv'
  <2>1. (TypeOK /\ Dispatch(k, p, c)) => TypeOK'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, TypeOK, Phases, Results, Tokens, Keys, Clients, Preps,
      Files, Digests, Intents, NoKey, NoPrep, PrepKey, PrepClient, PrepIntent,
      PrepBase, PrepAfter
  <2>2. (AtMostOnce /\ Dispatch(k, p, c)) => AtMostOnce'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, AtMostOnce
  <2>3. (UniqueLiveClaims /\ Dispatch(k, p, c)) => UniqueLiveClaims'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, UniqueLiveClaims
  <2>4. (ResourceCoherence /\ Dispatch(k, p, c)) => ResourceCoherence'
