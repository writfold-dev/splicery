  <2>5. (JournalBeforeIO /\ Dispatch(k, p, c)) => JournalBeforeIO'
    BY SMT DEF phaseVars, intentVars, reqPrepVars, reqClientVars, reqEpochVars, baseVars, baseWriterVars, afterVars, prepLiveVars, grantVars, cancelledVars, epochVars, fileStateVars, fileWriterVars, capturedVars, liveVars, journalVars, blockedVars, resultVars, writesVars, authorityAtWriteVars, preimageAtWriteVars, obsKeyVars, obsDigestVars, obsWriterVars, confirmKeyVars, confirmDigestVars, confirmWriterVars, everUnknownVars, Dispatch, JournalBeforeIO
  <2>6. (ActiveClaimRetention /\ Dispatch(k, p, c)) => ActiveClaimRetention'
